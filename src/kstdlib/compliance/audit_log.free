// K-Compliance 모듈 3 — 감사 및 로깅
// 규범: ISMS A.12.4.1, 개인정보의 안전성 확보조치 기준 제8조
// 로그에 원본 고유식별정보를 넣지 않는다.

변수 감사로그저장소 = []

함수 로그시각() -> 문자열 {
  반환 현재날짜시간()
}

함수 접근로그_기록(사용자ID: 문자열, 자원: 문자열, 접근유형: 문자열, 결과: 참거짓) -> 공집합 {
  변수 유형정상 = 거짓
  만약 접근유형 == "읽기" { 유형정상 = 참 }
  만약 접근유형 == "쓰기" { 유형정상 = 참 }
  만약 접근유형 == "삭제" { 유형정상 = 참 }
  만약 유형정상 == 거짓 {
    접근유형 = "읽기"
  }
  변수 결과문자 = "실패"
  만약 결과 {
    결과문자 = "성공"
  }
  변수 항목 = {
    시각: 로그시각(),
    종류: "접근",
    사용자ID: 사용자ID,
    자원: 자원,
    접근유형: 접근유형,
    결과: 결과문자
  }
  감사로그저장소 = 감사로그저장소 + [항목]
}

함수 보안이벤트_로그(이벤트유형: 문자열, 심각도: 문자열, 설명: 문자열) -> 공집합 {
  변수 유형정상 = 거짓
  만약 이벤트유형 == "인증실패" { 유형정상 = 참 }
  만약 이벤트유형 == "접근거부" { 유형정상 = 참 }
  만약 이벤트유형 == "이상탐지" { 유형정상 = 참 }
  만약 유형정상 == 거짓 {
    이벤트유형 = "이상탐지"
  }
  변수 심각정상 = 거짓
  만약 심각도 == "낮음" { 심각정상 = 참 }
  만약 심각도 == "중간" { 심각정상 = 참 }
  만약 심각도 == "높음" { 심각정상 = 참 }
  만약 심각도 == "심각" { 심각정상 = 참 }
  만약 심각정상 == 거짓 {
    심각도 = "중간"
  }
  변수 항목 = {
    시각: 로그시각(),
    종류: "보안이벤트",
    이벤트유형: 이벤트유형,
    심각도: 심각도,
    설명: 설명
  }
  감사로그저장소 = 감사로그저장소 + [항목]
}

함수 날짜만(시각: 문자열) -> 문자열 {
  만약 시각.길이 < 10 { 반환 시각 }
  변수 결과 = ""
  변수 i = 0
  반복 i = 0; i < 10; i = i + 1 {
    결과 = 결과 + 시각[i]
  }
  반환 결과
}

함수 감사로그_조회(시작일: 문자열, 종료일: 문자열, 필터: 문자열) -> 배열 {
  변수 결과 = []
  변수 i = 0
  반복 i = 0; i < 감사로그저장소.길이; i = i + 1 {
    변수 항목 = 감사로그저장소[i]
    변수 날짜 = 날짜만(항목.시각)
    변수 포함 = 참
    만약 시작일.길이 > 0 {
      만약 날짜 < 시작일 { 포함 = 거짓 }
    }
    만약 종료일.길이 > 0 {
      만약 날짜 > 종료일 { 포함 = 거짓 }
    }
    만약 필터.길이 > 0 {
      만약 항목.종류 != 필터 {
        만약 항목.이벤트유형 != 필터 {
          만약 항목.접근유형 != 필터 {
            포함 = 거짓
          }
        }
      }
    }
    만약 포함 {
      결과 = 결과 + [항목]
    }
  }
  반환 결과
}
