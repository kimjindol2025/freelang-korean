// K-Compliance 모듈 2 — 개인정보 보호
// 규범: 개인정보보호법 제23조·제24조의2, 안전성 확보조치 기준 제7조
// 비식별화·마스킹은 비가역 표시용이다. 복원 토큰을 만들지 않는다.

함수 구분기호_제거_pii(원본: 문자열) -> 문자열 {
  변수 결과 = ""
  변수 i = 0
  반복 i = 0; i < 원본.길이; i = i + 1 {
    변수 문자 = 원본[i]
    만약 문자 != "-" {
      만약 문자 != " " {
        결과 = 결과 + 문자
      }
    }
  }
  반환 결과
}

함수 별표반복(횟수: 숫자, 문자: 문자열) -> 문자열 {
  변수 결과 = ""
  변수 i = 0
  반복 i = 0; i < 횟수; i = i + 1 {
    결과 = 결과 + 문자
  }
  반환 결과
}

함수 주민번호_비식별화(데이터: 문자열) -> 문자열 {
  변수 숫자 = 구분기호_제거_pii(데이터)
  만약 숫자.길이 != 13 {
    반환 민감정보_마스킹(데이터, "*")
  }
  변수 앞 = ""
  변수 i = 0
  반복 i = 0; i < 6; i = i + 1 {
    앞 = 앞 + 숫자[i]
  }
  반환 앞 + "-" + 숫자[6] + "******"
}

함수 휴대폰_비식별화(데이터: 문자열) -> 문자열 {
  변수 숫자 = 구분기호_제거_pii(데이터)
  만약 숫자.길이 == 11 {
    반환 숫자[0] + 숫자[1] + 숫자[2] + "-****-" + 숫자[7] + 숫자[8] + 숫자[9] + 숫자[10]
  }
  만약 숫자.길이 == 10 {
    반환 숫자[0] + 숫자[1] + 숫자[2] + "-***-" + 숫자[6] + 숫자[7] + 숫자[8] + 숫자[9]
  }
  반환 민감정보_마스킹(데이터, "*")
}

함수 이메일_비식별화(데이터: 문자열) -> 문자열 {
  변수 at = -1
  변수 i = 0
  반복 i = 0; i < 데이터.길이; i = i + 1 {
    만약 데이터[i] == "@" {
      at = i
    }
  }
  만약 at <= 0 {
    반환 민감정보_마스킹(데이터, "*")
  }
  변수 도메인 = ""
  변수 j = at
  반복 j = at; j < 데이터.길이; j = j + 1 {
    도메인 = 도메인 + 데이터[j]
  }
  반환 데이터[0] + "***" + 도메인
}

함수 카드_비식별화(데이터: 문자열) -> 문자열 {
  변수 숫자 = 구분기호_제거_pii(데이터)
  만약 숫자.길이 < 12 {
    반환 민감정보_마스킹(데이터, "*")
  }
  변수 뒤 = ""
  변수 시작 = 숫자.길이 - 4
  변수 i = 시작
  반복 i = 시작; i < 숫자.길이; i = i + 1 {
    뒤 = 뒤 + 숫자[i]
  }
  반환 "****-****-****-" + 뒤
}

함수 개인정보_비식별화(데이터: 문자열, 유형: 문자열) -> 문자열 {
  만약 유형 == "주민번호" { 반환 주민번호_비식별화(데이터) }
  만약 유형 == "주민등록번호" { 반환 주민번호_비식별화(데이터) }
  만약 유형 == "휴대폰" { 반환 휴대폰_비식별화(데이터) }
  만약 유형 == "이메일" { 반환 이메일_비식별화(데이터) }
  만약 유형 == "카드번호" { 반환 카드_비식별화(데이터) }
  반환 민감정보_마스킹(데이터, "*")
}

함수 민감정보_마스킹(데이터: 문자열, 마스킹문자: 문자열) -> 문자열 {
  변수 기호 = 마스킹문자
  만약 기호.길이 == 0 { 기호 = "*" }
  변수 길이값 = 데이터.길이
  만약 길이값 == 0 { 반환 "" }
  만약 길이값 == 1 { 반환 기호 }
  만약 길이값 == 2 { 반환 데이터[0] + 기호 }
  변수 가릴수 = 길이값 - 2
  반환 데이터[0] + 별표반복(가릴수, 기호) + 데이터[길이값 - 1]
}

함수 개인정보_암호화(평문: 문자열, 알고리즘: 문자열) -> 문자열 {
  만약 알고리즘 == "ARIA-256" { 반환 ARIA_암호화(평문, "") }
  만약 알고리즘 == "SEED-128" { 반환 SEED_암호화(평문, "") }
  반환 ARIA_암호화(평문, "")
}

함수 개인정보_복호화(암호문: 문자열, 키: 문자열, 알고리즘: 문자열) -> 문자열 {
  만약 알고리즘 == "ARIA-256" { 반환 ARIA256_복호화(암호문, 키) }
  만약 알고리즘 == "SEED-128" { 반환 SEED128_복호화(암호문, 키) }
  반환 ARIA256_복호화(암호문, 키)
}
