// K-Compliance 모듈 7 — 규정 준수 검사
// 규범: 개인정보보호법 제15조, ISMS, PCI-DSS

함수 PIPA_개인정보수집동의_검증(수집항목: 배열, 동의여부: 참거짓, 동의날짜: 문자열) -> 참거짓 {
  만약 동의여부 == 거짓 { 반환 거짓 }
  만약 수집항목.길이 == 0 { 반환 거짓 }
  만약 동의날짜.길이 < 10 { 반환 거짓 }
  변수 i = 0
  반복 i = 0; i < 수집항목.길이; i = i + 1 {
    만약 수집항목[i] == "주민등록번호" {
      반환 거짓
    }
  }
  반환 참
}

함수 ISMS_보안수준_평가(항목: 배열) -> 맵 {
  변수 충분 = 0
  변수 부족 = 0
  변수 i = 0
  반복 i = 0; i < 항목.길이; i = i + 1 {
    변수 이름 = 항목[i]
    만약 이름 == "접근권한관리" {
      충분 = 충분 + 1
    } 아니면 만약 이름 == "암호화" {
      충분 = 충분 + 1
    } 아니면 만약 이름 == "접속기록" {
      충분 = 충분 + 1
    } 아니면 만약 이름 == "백업" {
      충분 = 충분 + 1
    } 아니면 {
      부족 = 부족 + 1
    }
  }
  반환 {
    충분: 충분,
    부족: 부족
  }
}

함수 카드번호_룬검증(번호: 문자열) -> 참거짓 {
  변수 숫자 = 구분기호_제거(번호)
  만약 숫자.길이 < 13 { 반환 거짓 }
  만약 숫자.길이 > 19 { 반환 거짓 }
  만약 모두_숫자인가(숫자) == 거짓 { 반환 거짓 }
  변수 합 = 0
  변수 두배 = 거짓
  변수 i = 숫자.길이 - 1
  반복 i = 숫자.길이 - 1; i >= 0; i = i - 1 {
    변수 값 = 문자_숫자(숫자[i])
    만약 두배 {
      값 = 값 * 2
      만약 값 > 9 { 값 = 값 - 9 }
    }
    합 = 합 + 값
    만약 두배 {
      두배 = 거짓
    } 아니면 {
      두배 = 참
    }
  }
  만약 합 % 10 == 0 { 반환 참 }
  반환 거짓
}

함수 만료일_형식확인(만료일: 문자열) -> 참거짓 {
  만약 만료일.길이 != 5 { 반환 거짓 }
  만약 만료일[2] != "/" { 반환 거짓 }
  변수 월 = 문자_숫자(만료일[0]) * 10 + 문자_숫자(만료일[1])
  변수 년 = 문자_숫자(만료일[3]) * 10 + 문자_숫자(만료일[4])
  만약 월 < 1 { 반환 거짓 }
  만약 월 > 12 { 반환 거짓 }
  만약 년 < 0 { 반환 거짓 }
  반환 참
}

함수 PCI_DSS_신용카드검증(카드번호: 문자열, 만료일: 문자열, CVV: 문자열) -> 참거짓 {
  만약 카드번호_룬검증(카드번호) == 거짓 { 반환 거짓 }
  만약 만료일_형식확인(만료일) == 거짓 { 반환 거짓 }
  만약 CVV.길이 != 3 {
    만약 CVV.길이 != 4 { 반환 거짓 }
  }
  만약 모두_숫자인가(CVV) == 거짓 { 반환 거짓 }
  반환 참
}
