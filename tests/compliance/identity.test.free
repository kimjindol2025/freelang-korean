// K-Compliance 신원 검증 테스트
// 값은 체크디지트 검증용 합성 번호다. 실존 식별자가 아니다.

함수 단언(이름: 문자열, 조건: 참거짓) -> 공집합 {
  만약 조건 {
    출력("PASS " + 이름)
  } 아니면 {
    출력("FAIL " + 이름)
  }
}

함수 main() -> 공집합 {
  단언("rrn-길이오류", 주민등록번호_유효성확인("123") == 거짓)
  단언("rrn-체크오류", 주민등록번호_유효성확인("900101-1000000") == 거짓)
  단언("rrn-체크정상", 주민등록번호_유효성확인("900101-1000006") == 참)
  단언("rrn-하이픈없음", 주민등록번호_유효성확인("9001011000006") == 참)
  단언("rrn-날짜오류", 주민등록번호_유효성확인("901301-1000006") == 거짓)
  단언("brn-길이오류", 사업자등록번호_유효성확인("123") == 거짓)
  단언("brn-체크정상", 사업자등록번호_유효성확인("123-45-67891") == 참)
  단언("brn-체크오류", 사업자등록번호_유효성확인("123-45-67890") == 거짓)
  단언("phone-정상", 국내휴대폰번호_유효성확인("010-1234-5678") == 참)
  단언("phone-010길이", 국내휴대폰번호_유효성확인("0101234567") == 거짓)
  단언("phone-앞자리오류", 국내휴대폰번호_유효성확인("020-1234-5678") == 거짓)
  단언("tel-서울", 국내전화번호_유효성확인("02-123-4567") == 참)
  단언("tel-경기", 국내전화번호_유효성확인("031-123-4567") == 참)
  단언("tel-오류", 국내전화번호_유효성확인("99-123-4567") == 거짓)
  단언("mask-phone", 개인정보_비식별화("010-1234-5678", "휴대폰") == "010-****-5678")
  단언("luhn-테스트카드", PCI_DSS_신용카드검증("4111111111111111", "12/30", "123") == 참)
  단언("luhn-실패", PCI_DSS_신용카드검증("4111111111111112", "12/30", "123") == 거짓)
}

main()
